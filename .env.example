# Generate with: openssl rand -hex 32. Never commit the real secret.
PAYLOAD_SECRET=
# Local: SQLite file. Vercel: the Neon Postgres connection string (postgresql://…?sslmode=require).
DATABASE_URL=file:./data/academie.db
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
# Vercel only: uploads go to Vercel Blob when this is set; locally they stay in media/.
# BLOB_READ_WRITE_TOKEN=
# Optional SMTP for password reset emails:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# Optional: activate the editorial assistant (server-side only).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
